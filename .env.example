# Copy to .env and fill in. Never commit .env (it's gitignored).
# Propsy reads ./.env at startup for any variable not already set in the real
# environment (real env vars win; empty values here are ignored).

# --- Both modes ---------------------------------------------------------------
# Selects the transport and storage: "local" (Socket Mode + SQLite) or "gcp"
# (HTTP webhooks + Firestore, for Cloud Run). Defaults to "local".
ENVIRONMENT=local

# Bot token, from OAuth & Permissions after installing the app (xoxb-...).
SLACK_BOT_TOKEN=

# Rate limits. Propsies and dropsies count together. Each period starts when
# someone first gives one, and once it has elapsed their allowance resets to the
# full limit. A limit of 0 disables that limit. Periods take s, m, h, d, w units (e.g. 30s,
# 24h, 30d, 2w, 1d12h). People can see their remaining allowance in the app's
# Home tab and by running /propsy with no arguments.
# Most one person can give in total (default 200 per 30d):
PROPSY_LIMIT=200
PROPSY_LIMIT_PERIOD=30d
# Most one person can give any single other person (default 5 per 1d):
PROPSY_PER_PERSON_LIMIT=5
PROPSY_PER_PERSON_LIMIT_PERIOD=1d

# Most people each Home-tab leaderboard lists. 0 lists everyone; set e.g. 10 for
# a top 10. There's a hard maximum of 1000 (Slack caps a Home tab at 100 blocks):
# 0 means "everyone, up to 1000", and a larger value is lowered to 1000 with a
# warning in the startup log.
PROPSY_LEADERBOARD_MAX_USERS=0

# Optional: announce propsies/dropsies in this channel instead of wherever the
# command was run (the giver gets a private confirmation). Use the channel ID
# (C0123ABCDEF: channel details → bottom of the About tab); #name also works
# for public channels but breaks if the channel is renamed. Invite the bot to
# the channel first (/invite @Propsy). If posting fails, it falls back to the
# channel the command was run in. Needs the chat:write scope (in the manifests).
PROPSY_ANNOUNCE_CHANNEL=

# --- ENVIRONMENT=local (Socket Mode) ------------------------------------------
# App-level token with the connections:write scope (xapp-...), from
# Basic Information → App-Level Tokens.
SLACK_APP_TOKEN=
# SQLite file path. Optional; defaults to ./propsy.db.
DB_PATH=./propsy.db

# --- ENVIRONMENT=gcp (Cloud Run) ----------------------------------------------
# Signing secret from Basic Information → App Credentials.
SLACK_SIGNING_SECRET=
# GCP project that hosts Firestore.
GCP_PROJECT_ID=
# Optional; defaults to (default). Keep it: Firestore's free quota only covers the
# (default) database, so a named one bills every read and write.
FIRESTORE_DATABASE_ID=(default)
# Optional; Cloud Run sets this automatically. Defaults to 8080.
PORT=8080

# --- Local development only ---------------------------------------------------
# Point the Firestore client at the local emulator (set by ./firestore.sh start).
# Leave unset to use real Firestore.
# FIRESTORE_EMULATOR_HOST=localhost:8219
